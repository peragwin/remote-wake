{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OTA signature envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kid",
    "payload",
    "sig",
    "v"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sig": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "$comment": "Verify exact decoded payload bytes with domain prefix before parsing. Base64url must be unpadded/canonical; signature decoded length64; payload decoded bound3072; envelope total bound6144."
}
