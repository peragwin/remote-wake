# Common defaults for all targets.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 4 MB flash is the smallest board we support; partitions.csv needs it.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# TLS: use the bundled root CA store so any public relay host validates.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# WebSocket client (managed component) needs a decent RX buffer for envelopes.
CONFIG_WS_TRANSPORT=y

# FreeRTOS / watchdog: relay task subscribes explicitly.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y

# Main task needs room for the boot flow (NVS + wifi + tinyusb init).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# HTTP server used only in setup mode; keep it small.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# Panic: reboot rather than sit in the debug prompt (GPIO must not latch).
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Do not let a brownout leave the power pin driven.
CONFIG_ESP_BROWNOUT_DET=y
